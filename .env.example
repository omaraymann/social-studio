DATABASE_URL=postgresql+psycopg://social_studio:social_studio@db:5432/social_studio
# Use the same local RAG database password configured in rag/.env.
RAG_DB_PASSWORD=replace-with-the-rag-database-password
# For the local FastAPI process keep 127.0.0.1; for an API container use host.docker.internal.
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5433
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_BYTES=2000000

# Create a webhook in a Discord channel you own. Leave blank until configured.
DISCORD_WEBHOOK_URL=
# Instagram accounts are connected through the dashboard; tokens are stored encrypted.
INSTAGRAM_API_VERSION=v25.0
# One-time operator configuration; users connect through Instagram OAuth.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Generate once with cryptography.fernet.Fernet.generate_key(); keep backed up.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:5173
# HTTPS origin that routes to this API, e.g. a temporary tunnel for local testing.
PUBLIC_MEDIA_BASE_URL=
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=30
MAX_PUBLISH_ATTEMPTS=3
RETRY_BASE_SECONDS=5

# Optional Phase 6 LLM generation through OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# Optional on-demand fact-check evidence audit (paid model calls).
JUDGE_AUDIT_MODEL=google/gemini-2.5-pro
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_INPUT_CHARACTERS=30000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private product references and generated visuals (excluded from Git).
IMAGE_STORAGE_DIR=data/campaign_images
IMAGE_TIMEOUT_SECONDS=120
